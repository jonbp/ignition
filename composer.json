{
  "name": "jonbp/ignition",
  "description": "The WordPress launch system",
  "license": "MIT",
  "authors": [
    {
      "name": "Jon Beaumont-Pike",
      "email": "me@jonbp.co.uk",
      "homepage": "https://jonbp.co.uk"
    }
  ],
  "homepage": "https://github.com/jonbp/ignition",
  "require": {
    "php": ">=8.2",
    "vlucas/phpdotenv": "^5.6",
    "symfony/yaml": "^7.0 || ^8.0"
  },
  "require-dev": {
    "bamarni/composer-bin-plugin": "^1.8"
  },
  "config": {
    "allow-plugins": {
      "bamarni/composer-bin-plugin": true
    },
    "platform": {
      "php": "8.2.0"
    }
  },
  "extra": {
    "bamarni-bin": {
      "bin-links": true,
      "forward-command": true
    }
  },
  "scripts": {
    "compile": "vendor/bin/box compile"
  }
}
